# SG Maid — environment variables
#
# This is a TEMPLATE only. Do not put real secrets in this file, and
# do not commit a real .env with actual values — .gitignore already
# excludes .env* (this .env.example file is explicitly un-ignored so
# it stays tracked).
#
# Phase 1 — Database (PostgreSQL + Prisma)
# Point this at your own PostgreSQL instance (local install, Docker, or
# a hosted provider). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# No default is provided here — there is no shared/assumed database.
DATABASE_URL=

# Phase 2 — Authentication (Auth.js) — not wired up yet
AUTH_SECRET=

# Used by both the app and any server-side callback URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
