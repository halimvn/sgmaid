# SG Maid — environment variables
#
# This is a TEMPLATE only. Do not put real secrets in this file, and
# do not commit a real .env with actual values — .gitignore already
# excludes .env* (this .env.example file is explicitly un-ignored so
# it stays tracked).
#
# Phase 1 — Database (PostgreSQL + Prisma)
# Point these at your own PostgreSQL instance. No default is provided —
# there is no shared/assumed database.
#
# Self-hosted Postgres (local install / Docker): DATABASE_URL and
# DIRECT_URL can be the same value:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Hosted/serverless providers with connection pooling (Supabase, Neon):
# use the POOLED connection string for DATABASE_URL (what the running app
# uses at runtime — lib/db.ts) and the DIRECT connection string for
# DIRECT_URL (what Prisma Migrate/CLI uses — prisma.config.ts). On
# Supabase's dashboard (Project Settings → Database → Connection string),
# these are the "Transaction pooler" (port 6543, add ?pgbouncer=true) and
# "Session pooler" or direct (port 5432) strings respectively.
DATABASE_URL=
DIRECT_URL=

# Phase 2 — Authentication (Auth.js v5 / next-auth)
# Required. Used to sign/encrypt session JWTs and CSRF tokens. Generate a
# strong random value for your local .env, e.g.:
#   npx auth secret
# or:
#   openssl rand -base64 33
# Never commit a real value here or in .env — generate your own locally.
AUTH_SECRET=

# Used by both the app (dev-only invitation/reset link scripts — see
# scripts/create-dev-employer-invite.ts) and any server-side callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 4.6 — Supabase Storage (private maid biodata PDFs only)
# Unrelated to DATABASE_URL/DIRECT_URL above — this is Supabase's Storage
# API, not Postgres. Used only by lib/storage/supabase-admin.ts to
# generate short-lived signed URLs for the private "maid-biodata" bucket;
# never exposed to the browser, never used as a database client.
#
# SUPABASE_URL is the project's API URL (Project Settings → API → Project URL,
# e.g. https://xxxxx.supabase.co — NOT the pooler hostname used in
# DATABASE_URL above).
# SUPABASE_SERVICE_ROLE_KEY is the secret service_role key from the same
# page. It bypasses Row Level Security — server-only, never prefix with
# NEXT_PUBLIC_, never commit, never log, never print.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for private maid biodata PDFs. Must be a PRIVATE
# bucket (not public) — see scripts/setup-maid-storage-bucket.ts.
SUPABASE_MAID_DOCUMENT_BUCKET=maid-biodata
