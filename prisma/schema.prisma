// ============================================================
// SG Maid — Database Schema
// ============================================================
// PostgreSQL + Prisma. Phase 1 defined the core data model (maids,
// skills, training, shortlist/consultation/enquiry scaffolding). Phase 2
// added the authentication foundation (UserAuthToken, AuthTokenPurpose,
// LoginAttempt, User.sessionVersion) in a separate migration —
// see prisma/migrations/ for the split. See README.md for setup
// instructions.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL no longer lives here. Migrate/CLI commands
// read it from prisma.config.ts (see that file); the runtime PrismaClient
// gets it via a driver adapter, wired up in lib/db.ts.
datasource db {
  provider = "postgresql"
}

// ============================================================
// USER  (employers today; also hosts SG Maid admin accounts later)
// ============================================================

enum UserRole {
  EMPLOYER
  ADMIN
}

enum UserStatus {
  PENDING // registered but not yet approved for portal access
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id            String     @id @default(cuid())
  fullName      String
  // Phase 8 (staff-created client access): no longer the employer login
  // identifier — see `username` below. Kept as optional CONTACT
  // information only (still required/used for ADMIN login, unchanged).
  // Nullable so an employer created by staff, who was never asked for an
  // email, doesn't need one. Still @unique: Postgres treats every NULL as
  // distinct for a unique index, so any number of employers can leave it
  // blank without colliding with each other.
  email         String?    @unique
  // Phase 8: the EMPLOYER/client login identifier — set once by SG Maid
  // staff (see lib/services/admin/clients.ts) and never self-service
  // editable by the client (see lib/services/account.ts). ADMIN accounts
  // don't get one; they keep logging in by email (see auth.ts /
  // lib/auth/credentials.ts for how a single Credentials provider tells
  // the two identifier shapes apart). Always stored already-normalized
  // (trim + lowercase — see lib/auth/username.ts) so a case-insensitive
  // lookup is just an equality match, no citext/collation extension
  // needed.
  username      String?    @unique
  mobileNumber  String?
  // Nullable by design, not just "not built yet": an ADMIN account is
  // still provisioned via the invitation flow (status starts PENDING,
  // passwordHash null) → the admin sets their own password via
  // /setup-password → the account becomes usable. A client/EMPLOYER
  // account (Phase 8) instead gets its passwordHash set directly at
  // creation time by SG Maid staff — see lib/services/admin/clients.ts —
  // so it goes straight to ACTIVE with no PENDING/invite step. Staff never
  // learn an ADMIN's own password.
  passwordHash  String?
  role          UserRole   @default(EMPLOYER)
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?
  // Phase 8: for an EMPLOYER/client account, the moment staff-issued
  // access stops being valid — set to "now + 72 hours" at creation
  // (lib/auth/constants.ts CLIENT_ACCESS_DURATION_MS) and re-set whenever
  // staff extends/reactivates access (lib/services/admin/clients.ts).
  // Always computed server-side, never accepted from a client request.
  // NULL for ADMIN accounts, which aren't subject to this at all — see
  // evaluateAccess() in lib/auth/authorize.ts, which only enforces this
  // for role EMPLOYER. Checked on every protected request (not just at
  // login), so an already-issued session stops working the moment this
  // passes, the same way a status change or sessionVersion bump already
  // does.
  accessExpiresAt DateTime?
  // Phase 2: bumped whenever every existing session for this user should
  // stop working immediately (password reset, security change, staff
  // revoking access) — see lib/auth/authorize.ts. The session's JWT
  // captures the value at sign-in time; every protected request compares
  // it against the current column value, so a mismatch means "this
  // session predates a revocation" and access is rejected even though the
  // signed cookie itself is still technically valid.
  sessionVersion Int       @default(0)

  shortlist            Shortlist[]
  consultationRequests ConsultationRequest[]
  authTokens           UserAuthToken[]
  auditLogs            AuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================================
// AUTH TOKENS  (account setup + password reset — Phase 2)
// ============================================================
// Single-use, expiring, hashed tokens. The raw token is never persisted —
// only a SHA-256 hash of it (see lib/auth/tokens.ts) — so a database read
// alone can never hand out a usable token or reset link.

enum AuthTokenPurpose {
  ACCOUNT_SETUP
  PASSWORD_RESET
}

model UserAuthToken {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@map("user_auth_tokens")
}

// ============================================================
// LOGIN ATTEMPTS  (persistent rate limiting — Phase 2)
// ============================================================
// Deliberately NOT in-memory: this app will eventually run on
// serverless/edge infrastructure (Vercel) where in-process memory isn't
// shared or durable across invocations. `identifierHash` is a SHA-256
// hash of the normalized email + a coarse client identifier (never the
// raw email/IP pair) — see lib/auth/rate-limit.ts. Rows are short-lived
// signal, not an audit log: no password or other sensitive data is ever
// stored here.

model LoginAttempt {
  id             String   @id @default(cuid())
  identifierHash String
  succeeded      Boolean
  createdAt      DateTime @default(now())

  @@index([identifierHash, createdAt])
  @@map("login_attempts")
}

// ============================================================
// MAID PROFILE
// ============================================================
// Profile visibility (profileStatus) and current placement
// (availabilityStatus) are deliberately separate. A profile can stay
// ACTIVE while its availability moves between AVAILABLE / RESERVED /
// PLACED / UNAVAILABLE — we never need to delete a profile just
// because a candidate's situation changes.

enum MaidProfileStatus {
  DRAFT // being entered by staff, not ready for employer visibility
  ACTIVE
  INACTIVE // withdrawn/retired, kept for records
}

enum MaidAvailabilityStatus {
  AVAILABLE
  RESERVED // shortlisted/in discussion with an employer
  PLACED // currently deployed with an employer (was "deployed" in the frontend mock)
  UNAVAILABLE
}

// Phase 4.6 / 4.6.3: the candidate's work-history category, derived from
// the biodata's own declared work-permit/employment history — never a
// separate raw input, never inferred when the source doesn't support it.
//   NEW           — no prior overseas domestic-work experience at all.
//   TRANSFER      — currently on an active Singapore work permit, being
//                   transferred directly to a new employer.
//   EX_SINGAPORE  — previously completed a Singapore work permit/contract
//                   (not an active transfer) and is now available again.
//   EX_OTHERS     — prior overseas domestic-work experience outside
//                   Singapore only (e.g. Hong Kong, Taiwan, the Middle
//                   East), applying to Singapore for the first time.
enum MaidType {
  NEW
  TRANSFER
  EX_SINGAPORE
  EX_OTHERS
}

// Phase 4.6: added because real SG Maid biodata consistently includes it
// and it's employer-facing per the agreed dashboard scope. Deliberately a
// small, fixed enum rather than free text.
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

model MaidProfile {
  id       String @id @default(cuid())
  // Human-readable, employer-facing identifier — e.g. "SG-00001" for
  // fictional dev records, or the source agency's own reference code
  // (e.g. "DV155") for real imported candidates — see
  // scripts/import-real-maid.ts.
  profileCode String @unique

  name        String
  photoUrl    String?
  nationality String
  // Stored as a date of birth rather than a raw age so the value never
  // goes stale — age is derived at read time, not persisted redundantly.
  dateOfBirth DateTime?
  // Simple string list — see "Languages" note in the Phase 1 summary
  // for why this doesn't need its own table yet.
  languages   String[] @default([])

  // Overall years of experience as a quick-glance/filter value.
  // Independent from the detailed EmploymentHistory rows below —
  // matches the flat field the dashboard already expects.
  yearsExperience Int @default(0)

  profileStatus      MaidProfileStatus       @default(DRAFT)
  availabilityStatus MaidAvailabilityStatus  @default(UNAVAILABLE)

  // Phase 4.6 — all three sourced from real SG Maid biodata PDFs and
  // confirmed as part of the employer-facing dashboard scope. Nullable:
  // existing fictional seed records don't set them, and not every real
  // biodata may state all three clearly.
  heightCm      Int?
  weightKg      Int?
  maritalStatus MaritalStatus?
  maidType      MaidType?

  // Staff-only. Must never be selected into any employer-facing query
  // or API response — see Phase 1 summary "Internal notes" for the
  // privacy boundary.
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employmentHistory EmploymentHistory[]
  skills            MaidSkill[]
  trainings         MaidTraining[]
  shortlistedBy     Shortlist[]
  consultationLinks ConsultationMaid[]
  documents         MaidDocument[]

  @@index([nationality])
  @@index([profileStatus])
  @@index([availabilityStatus])
  @@index([profileStatus, availabilityStatus])
  @@map("maid_profiles")
}

// ============================================================
// EMPLOYMENT HISTORY  (1 maid : many records)
// ============================================================

model EmploymentHistory {
  id      String      @id @default(cuid())
  maid    MaidProfile @relation(fields: [maidId], references: [id], onDelete: Cascade)
  maidId  String

  country            String
  // Phase 4.6: real SG Maid biodata consistently states employment
  // periods as years only ("2023"–"2025"), never exact dates — unlike
  // the fictional seed data, which does have exact dates. startDate/
  // endDate are now nullable and used only when a genuine full date is
  // known; startYear/endYear hold year-only precision instead. Exactly
  // one of (startDate, startYear) — and, if the role has ended, one of
  // (endDate, endYear) — should be set per row; never invent a day/month
  // that isn't actually known.
  startDate          DateTime?
  endDate            DateTime?
  startYear          Int?
  endYear            Int?
  duties             String?
  // Anonymised summary of the household — never a named, identifiable
  // past employer.
  householdDescription String?
  reasonForLeaving   String?
  notes              String?
  // Explicit ordering for display, since insertion order isn't a
  // reliable UI contract.
  displayOrder       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([maidId])
  @@map("employment_history")
}

// ============================================================
// MAID DOCUMENTS  (private biodata PDF storage — Phase 4.6)
// ============================================================
// Only the storage path is kept here — never a public URL, never the file
// itself. The application generates a short-lived signed URL on demand
// (see lib/services/maid-documents.ts) only after the same employer-
// visibility check used everywhere else on a maid profile succeeds.
// Reusable model (not fields bolted onto MaidProfile) because more
// document types are expected eventually; only BIODATA_PDF and
// PROFILE_PHOTO (Phase 4.6.2 — an explicitly-approved candidate photo,
// never auto-extracted) are implemented — do not add passport/FIN/
// medical/work-permit document types until there's a real, confirmed
// need for them.

enum MaidDocumentType {
  BIODATA_PDF
  PROFILE_PHOTO
}

model MaidDocument {
  id     String      @id @default(cuid())
  maid   MaidProfile @relation(fields: [maidId], references: [id], onDelete: Cascade)
  maidId String

  type             MaidDocumentType
  // Internal Supabase Storage object path, e.g.
  // "maid-biodata/DV155/biodata.pdf" — deliberately keyed by profileCode,
  // not by name/DOB/internal id, to avoid encoding personal data into the
  // path itself.
  storagePath      String
  originalFileName String?
  mimeType         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One current document per type per maid — re-uploading a biodata PDF
  // replaces the existing row rather than accumulating duplicates.
  @@unique([maidId, type])
  @@map("maid_documents")
}

// ============================================================
// SKILLS
// ============================================================

// Phase 4.6.3: INFANT_CARE was split out from CHILDCARE. Phase 6.1 added
// DISABILITY_CARE. The approved employer-facing "Expertise" categories
// are Cooking, Eldercare, Childcare, Infantcare, General Housekeeping,
// and Care of Disabled (see lib/validation/maid-filters.ts
// EXPERTISE_CATEGORIES). PET_CARE predates that approved list and is kept
// only because existing Skill rows already reference it (never delete a
// category out from under real data) — it is deliberately excluded from
// the employer-facing filter facets.
enum SkillCategory {
  CHILDCARE
  INFANT_CARE
  ELDERLY_CARE
  HOUSEKEEPING
  COOKING
  PET_CARE
  DISABILITY_CARE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERIENCED
  EXPERT
}

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  category SkillCategory

  maids MaidSkill[]

  @@index([category])
  @@map("skills")
}

model MaidSkill {
  id     String @id @default(cuid())
  maid   MaidProfile @relation(fields: [maidId], references: [id], onDelete: Cascade)
  maidId String
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)
  skillId String

  experienceLevel SkillLevel?
  yearsExperience Int?
  notes           String?

  createdAt DateTime @default(now())

  @@unique([maidId, skillId])
  @@index([skillId])
  @@map("maid_skills")
}

// ============================================================
// TRAINING
// ============================================================
// Module names are grounded in the site's own copy: the "One-Day
// Training Handbook" and the "Settling-In Program (SIP)" are both
// referenced on services.html / contact.html today.

model TrainingModule {
  id          String  @id @default(cuid())
  title       String  @unique
  description String?
  category    String?
  displayOrder Int    @default(0)
  isActive    Boolean @default(true)

  maids MaidTraining[]

  @@map("training_modules")
}

model MaidTraining {
  id               String         @id @default(cuid())
  maid             MaidProfile    @relation(fields: [maidId], references: [id], onDelete: Cascade)
  maidId           String
  trainingModule   TrainingModule @relation(fields: [trainingModuleId], references: [id], onDelete: Restrict)
  trainingModuleId String

  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?

  @@unique([maidId, trainingModuleId])
  @@index([trainingModuleId])
  @@map("maid_trainings")
}

// ============================================================
// SHORTLIST  (model only — no shortlist logic/API in this phase)
// ============================================================

model Shortlist {
  id     String      @id @default(cuid())
  employer   User        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  employerId String
  maid       MaidProfile @relation(fields: [maidId], references: [id], onDelete: Cascade)
  maidId     String

  createdAt DateTime @default(now())

  @@unique([employerId, maidId])
  @@index([maidId])
  @@map("shortlists")
}

// ============================================================
// CONSULTATION REQUEST  (authenticated employer → consultant)
// ============================================================
// Phase 1.5 revision: a consultation now preserves *which* maid(s) it was
// about via the ConsultationMaid join below, snapshotting the selection at
// request time. This is deliberately independent of Shortlist — an
// employer's shortlist can keep changing after the request is made without
// altering what SG Maid staff see the request was originally about. This
// is schema only: no consultation request/create logic exists yet.

enum ConsultationStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ContactMethod {
  PHONE
  WHATSAPP
  EMAIL
}

model ConsultationRequest {
  id     String @id @default(cuid())
  employer   User   @relation(fields: [employerId], references: [id], onDelete: Restrict)
  employerId String

  message               String?
  preferredContactMethod ContactMethod @default(WHATSAPP)
  status                ConsultationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maids ConsultationMaid[]

  @@index([employerId])
  @@index([status])
  @@map("consultation_requests")
}

// Join table preserving which maid(s) a consultation request was about,
// independent of the employer's Shortlist (which can keep changing after
// the request is made). A snapshot, not a live pointer to the shortlist.
model ConsultationMaid {
  id                     String               @id @default(cuid())
  consultationRequest    ConsultationRequest  @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)
  consultationRequestId  String
  // Restrict, not Cascade: maid profiles are generally not deleted (see
  // MaidProfile note above) — this protects a consultation's historical
  // record from silently losing entries if a maid profile ever were
  // hard-deleted, rather than cascading the loss.
  maid                   MaidProfile          @relation(fields: [maidId], references: [id], onDelete: Restrict)
  maidId                 String

  createdAt DateTime @default(now())

  @@unique([consultationRequestId, maidId])
  @@index([maidId])
  @@map("consultation_maids")
}

// ============================================================
// PUBLIC ENQUIRY  (anonymous website Contact Us / hero form)
// ============================================================
// Deliberately separate from ConsultationRequest: this has no
// employerId (the submitter isn't authenticated) and maps directly to
// the two public forms already in the app — see
// components/site/EnquiryForm.tsx — "Who needs care?" on the homepage
// and "Which service do you need?" on the Contact page.

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum EnquirySource {
  HOMEPAGE
  CONTACT_PAGE
}

model Enquiry {
  id     String        @id @default(cuid())
  name   String
  phone  String
  // Free text: the two forms have different option sets ("Children /
  // Elderly / Household / Multiple" vs. "Deployment / Packages / House
  // Call / Counselling / Permit Renewal"), so a single shared enum
  // would force one form's options onto the other.
  careOrServiceNeeded String?
  message             String?
  source              EnquirySource
  status              EnquiryStatus @default(NEW)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("enquiries")
}

// ============================================================
// AUDIT LOG  (Phase 6 — admin maid management)
// ============================================================
// A simple, append-only trail of who did what to which maid profile.
// Deliberately minimal: no PDF/photo contents, no passwords/tokens, no
// medical information, no full before/after snapshots — just actor,
// action, target, and when. A future admin activity view can read this;
// nothing in this phase builds one.

enum AuditAction {
  MAID_CREATED
  MAID_UPDATED
  PROFILE_STATUS_CHANGED
  AVAILABILITY_CHANGED
  BIODATA_UPLOADED
  PROFILE_PHOTO_UPLOADED
  // Phase 8 — staff-created client access (lib/services/admin/clients.ts).
  // Never accompanied by a password or passwordHash value anywhere in
  // this row — see that file's logClientAudit().
  CLIENT_ACCESS_CREATED
  CLIENT_ACCESS_EXTENDED
  CLIENT_PASSWORD_RESET
  CLIENT_STATUS_CHANGED
}

model AuditLog {
  id     String @id @default(cuid())
  // Restrict, not Cascade: an audit trail must survive even if the actor
  // account is ever removed — same reasoning as ConsultationMaid.maid.
  actor   User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId String

  action AuditAction
  // Not a relation/FK on purpose: a maid profile is never hard-deleted
  // (see MaidProfile's "operational removal" note), but keeping this as
  // a plain string means the audit trail is never blocked by or coupled
  // to MaidProfile's own lifecycle either way.
  maidId String?
  // Phase 8: same non-FK-on-purpose reasoning as maidId, for the
  // CLIENT_* actions above — the target client User row. Never the same
  // field as maidId (a row describes either a maid action or a client
  // action, never both).
  targetUserId String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([maidId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
